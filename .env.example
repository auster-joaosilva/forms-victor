# Copie para .env.local e preencha. O .env.local nao vai para o git.

# PostgreSQL
DATABASE_URL="postgresql://usuario:senha@localhost:5432/victor_forms"

# MinIO (S3). forcePathStyle e obrigatorio — ver src/lib/s3.ts.
S3_ENDPOINT="http://localhost:9000"
S3_BUCKET="auster-formularios"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# Minutos de validade da URL assinada de upload.
S3_UPLOAD_URL_TTL_MINUTOS="15"

# --- docker-compose / Dokploy (nao usados pelo `npm run dev`) ---
POSTGRES_USER="victor"
POSTGRES_PASSWORD="victor"
POSTGRES_DB="victor_forms"
MINIO_ROOT_USER="minioadmin"
MINIO_ROOT_PASSWORD="minioadmin"
# Endereco do MinIO visto pelo NAVEGADOR — entra na assinatura do PUT.
S3_ENDPOINT_PUBLICO="http://localhost:9000"
