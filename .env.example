# Copie para .env.local e preencha. O .env.local nao vai para o git.

# PostgreSQL
DATABASE_URL="postgresql://usuario:senha@localhost:5432/victor_forms"

# MinIO (S3). forcePathStyle e obrigatorio — ver src/lib/s3.ts.
S3_ENDPOINT="http://localhost:9000"
S3_BUCKET="forms-victor"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# Minutos de validade da URL assinada de upload.
S3_UPLOAD_URL_TTL_MINUTOS="15"

# No Dokploy, as mesmas variaveis vao na aba Environment da aplicacao:
# S3_ENDPOINT="https://s3.austercontabil.com.br" (dominio publico — a URL
# assinada carrega o host e o PUT sai do navegador).
